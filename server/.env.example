# FamilyShield backend configuration.
# Copy to server/.env and run: node --env-file=server/.env server/index.js
# Never commit .env — it holds provider credentials.

# --- Server ---------------------------------------------------------------
FS_PORT=8787
FS_HOST=0.0.0.0
# FS_DATA_DIR=./server/data

# Sign bearer tokens. Required in production; development generates one once
# under FS_DATA_DIR/.token-secret.
# FS_TOKEN_SECRET=

# 1 = log OTP codes instead of sending them. NEVER enable in production.
FS_DEV_MODE=0

# --- SMS (OTP delivery) ---------------------------------------------------
# none | twilio. With "none" outside dev mode, OTP requests answer
# 503 provider_not_configured instead of pretending an SMS was sent.
FS_OTP_PROVIDER=none
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+10000000000

# --- Push (family alerts, nearby helpers) --------------------------------
# none | fcm
FS_PUSH_PROVIDER=none
# FS_FCM_SERVICE_ACCOUNT=C:\path\to\firebase-service-account.json
# FS_FCM_PROJECT_ID=

# --- Behaviour ------------------------------------------------------------
FS_OTP_TTL_SECONDS=300
FS_OTP_MAX_ATTEMPTS=5
FS_OTP_PHONE_LIMIT=3
FS_OTP_IP_LIMIT=10
FS_OTP_WINDOW_SECONDS=600
FS_SESSION_TTL_DAYS=30

# The ONLY place the nearby-helper radius is defined.
FS_NEARBY_RADIUS_M=2000
FS_NEARBY_MAX_HELPERS=5
FS_EMERGENCY_TTL_SECONDS=1800
FS_EMERGENCY_RATE_LIMIT=3
FS_EMERGENCY_RATE_WINDOW=1800
FS_FAMILY_INVITE_RATE_LIMIT=20
FS_REPORT_RATE_LIMIT=10

# --- Optional webhook -----------------------------------------------------
# FS_WEBHOOK_URL=
# FS_WEBHOOK_SECRET=
